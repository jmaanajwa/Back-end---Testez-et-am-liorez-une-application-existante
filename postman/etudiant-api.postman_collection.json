    {
      "name": "06 - Connexion et recuperation du JWT",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "login",
              "value": "{{testLogin}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{testPassword}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut HTTP 200', () => pm.response.to.have.status(200));",
              "const token = pm.response.text().trim();",
              "const valid = pm.response.code === 200 && /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/.test(token);",
              "pm.test('JWT present dans la reponse texte', () => pm.expect(valid).to.eql(true));",
              "if (valid) pm.collectionVariables.set('token', token);",
              "else pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
