{
  "info": {
    "name": "Etudiant Backend - Tests API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executer toute la collection dans l ordre. Couvre les 7 routes metier et /actuator/health. Cree un compte unique par execution et supprime uniquement l etudiant cree par ce scenario. Les autres endpoints techniques Actuator ne font pas partie de ce scenario."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "testLogin",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": ""
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Pas d erreur serveur', () => pm.expect(pm.response.code).to.be.below(500));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Sante du backend",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Service UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Inscription du compte de test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Postman\",\n  \"login\": \"{{testLogin}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('testLogin', 'postman-' + suffix);",
              "pm.collectionVariables.set('testPassword', 'Api-Test!-' + suffix);",
              "pm.collectionVariables.set('studentEmail', 'postman-' + suffix + '@example.com');",
              "pm.collectionVariables.set('token', '');",
              "pm.collectionVariables.set('studentId', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
