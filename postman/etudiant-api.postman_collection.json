    {
      "name": "14 - Creation de l etudiant de test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Postman\",\n  \"email\": \"{{studentEmail}}\",\n  \"className\": \"TEST-API\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut HTTP 201', () => pm.response.to.have.status(201));",
              "let data;",
              "try { data = pm.response.json(); } catch (_) { data = {}; }",
              "const valid = pm.response.code === 201 && Number.isSafeInteger(data.id) && data.id > 0;",
              "pm.test('Identifiant cree valide', () => pm.expect(valid).to.eql(true));",
              "if (valid) pm.collectionVariables.set('studentId', String(data.id));",
              "else pm.execution.setNextRequest(null);",
              "pm.test('Les champs de l etudiant correspondent', () => {",
              "  const data = pm.response.json();",
              "  const expected = JSON.parse(pm.variables.replaceIn(\"{\\\"firstName\\\":\\\"Test\\\",\\\"lastName\\\":\\\"Postman\\\",\\\"email\\\":\\\"{{studentEmail}}\\\",\\\"className\\\":\\\"TEST-API\\\"}\"));",
              "  Object.keys(expected).forEach(key => pm.expect(data[key], key).to.eql(expected[key]));",
              "  pm.expect(data.id).to.eql(Number(pm.collectionVariables.get('studentId')));",
              "});"
            ]
          }
        }
      ]
    },
